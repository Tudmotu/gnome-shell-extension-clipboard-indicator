msgid "Window class name, e.g. \"KeePassXC\""
msgstr "Nombre de la clase de ventana, p. ej., \"KeePassXC\""

#: prefs.js:752
msgid "Choose from installed applications"
msgstr "Elegir entre las aplicaciones instaladas"

#: prefs.js:769
