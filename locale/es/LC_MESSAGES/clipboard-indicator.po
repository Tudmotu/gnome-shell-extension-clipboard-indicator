msgid "Limits"
msgstr "Límites"

#: prefs.js:107 prefs.js:352
msgid "Exclusion"
msgstr "Exclusiones"

#: prefs.js:108 prefs.js:354
msgid "Topbar"
msgstr "Barra superior"

#: prefs.js:109 prefs.js:355
msgid "Notifications"
msgstr "Notificaciones"

#: prefs.js:110 prefs.js:356
msgid "Shortcuts"
msgstr "Atajos de teclado"

#: prefs.js:111
msgid "Import / Export"
msgstr "Importar / Exportar"

#: prefs.js:129
msgid "History Size"
msgstr "Tamaño del historial"

#: prefs.js:130
msgid "Maximum number of entries to keep in clipboard history"
msgstr ""
"Número máximo de entradas que se guardan en el historial del portapapeles"

#: prefs.js:139
msgid "Preview Size (characters)"
msgstr "Tamaño de previsualización (caracteres)"

#: prefs.js:140
msgid "Number of characters shown per entry in the history menu"
msgstr ""
"Número de caracteres que se muestran por entrada en el menú del historial"

#: prefs.js:149
msgid "Max cache file size (MB)"
msgstr "Tamaño máximo de caché (MB)"

#: prefs.js:150
msgid "Maximum disk space used for caching clipboard data"
msgstr ""
"Espacio máximo en disco para guardar en caché los datos del portapapeles"

#: prefs.js:159
msgid "Number of characters in top bar"
msgstr "Número de caracteres en la barra superior"

#: prefs.js:160
msgid "Length of the clipboard content preview shown in the panel"
msgstr ""
"Longitud de la previsualización del contenido del portapapeles en la barra "
"superior"

#: prefs.js:169
msgid "What to show in top bar"
msgstr "Qué mostrar en la barra superior"

#: prefs.js:174
msgid "Remove down arrow in top bar"
msgstr "Quitar la flecha hacia abajo de la barra de arriba"

#: prefs.js:175
msgid "Hide the dropdown arrow next to the clipboard indicator"
msgstr "Ocultar la flecha desplegable junto al indicador del portapapeles"

#: prefs.js:179
msgid "Blink icon on copy"
msgstr "Hacer parpadear el icono al copiar"

#: prefs.js:180
msgid "Briefly flash the indicator icon when something is copied"
msgstr "Hacer parpadear brevemente el icono del indicador cuando se copia algo"

#: prefs.js:184
msgid "Cache only pinned items"
msgstr "Cachear sólo los ítems anclados"

#: prefs.js:185
msgid "Only save pinned (favorite) entries to disk"
msgstr "Guardar en disco solo las entradas ancladas (favoritas)"

#: prefs.js:189
msgid "Show notification on copy"
msgstr "Mostrar una notificación al copiar"

#: prefs.js:190
msgid "Display a notification each time text is copied"
msgstr "Mostrar una notificación cada vez que se copia texto"

#: prefs.js:194
msgid "Show notification on cycle"
msgstr "Mostrar una notificación al cambiar de entrada"

#: prefs.js:195
msgid "Display a notification when cycling through entries with shortcuts"
msgstr ""
"Mostrar una notificación al recorrer las entradas con los atajos de teclado"

#: prefs.js:199
msgid "Show notification on Clear History"
msgstr "Mostrar una notificación al vaciar el historial"

#: prefs.js:200
msgid "Display a notification when clipboard history is cleared"
msgstr "Mostrar una notificación cuando se vacía el historial del portapapeles"

#: prefs.js:204
msgid "Prompt for confirmation on Clear History"
msgstr "Pedir confirmación al vaciar el historial"

#: prefs.js:205
msgid "Ask before deleting all clipboard entries"
msgstr "Preguntar antes de eliminar todas las entradas del portapapeles"

#: prefs.js:209
msgid "Prompt before deleting pinned item"
msgstr "Confirmar la eliminación de ítems anclados"

#: prefs.js:210
msgid "Ask for confirmation before deleting a pinned item"
msgstr "Pedir confirmación antes de eliminar un ítem anclado"

#: prefs.js:214
msgid "Remove whitespace around text"
msgstr "Eliminar espacios en blanco alrededor del texto"

#: prefs.js:215
msgid "Strip leading and trailing whitespace from text entries on copy"
msgstr ""
"Quitar los espacios en blanco al principio y al final de las entradas de "
"texto al copiar"

#: prefs.js:219
msgid "Move item to the top after selection"
msgstr "Mover el ítem hacia arriba después de seleccionarlo"

#: prefs.js:220
msgid "When selecting an entry, bring it to the top of the history"
msgstr "Al seleccionar una entrada, moverla al principio del historial"

#: prefs.js:224
msgid "Keep selected entry after Clear History"
msgstr "Mantener la entrada seleccionada después de limpiar el historial"

#: prefs.js:225
msgid ""
"The currently active clipboard entry will not be removed when clearing "
"history"
msgstr ""
"La entrada activa del portapapeles no se eliminará al vaciar el historial"

#: prefs.js:229
msgid "Place the pinned section on the bottom"
msgstr "Situar la sección anclada abajo"

#: prefs.js:230
msgid "Move the pinned section to the bottom of the menu. Requires re-login"
msgstr ""
"Mover la sección anclada a la parte inferior del menú. Requiere volver a "
"iniciar sesión"

#: prefs.js:234
msgid "Show Search Bar"
msgstr "Mostrar la barra de búsqueda"

#: prefs.js:235
msgid "Display a search field at the top of the clipboard menu"
msgstr ""
"Mostrar un campo de búsqueda en la parte superior del menú del portapapeles"

#: prefs.js:238
msgid "Show Private Mode"
msgstr "Mostrar el modo privado"

#: prefs.js:239
msgid "Display the private mode toggle in the clipboard menu"
msgstr "Mostrar el interruptor del modo privado en el menú del portapapeles"

#: prefs.js:242
msgid "Show Settings Button"
msgstr "Mostrar el botón de configuración"

#: prefs.js:243
msgid "Display a shortcut to these settings in the clipboard menu"
msgstr ""
"Mostrar un acceso directo a esta configuración en el menú del portapapeles"

#: prefs.js:246
msgid "Show Clear History Button"
msgstr "Mostrar el botón de vaciar el historial"

#: prefs.js:247
msgid "Display the clear history button in the clipboard menu"
msgstr "Mostrar el botón de vaciar el historial en el menú del portapapeles"

#: prefs.js:251
msgid "Clear clipboard history on system reboot"
msgstr "Vaciar el historial del portapapeles al reiniciar el sistema"

#: prefs.js:252
msgid "Delete all cached clipboard entries when the system starts"
msgstr ""
"Eliminar todas las entradas del portapapeles en caché al iniciar el sistema"

#: prefs.js:256
msgid "Paste on select"
msgstr "Pegar al seleccionar"

#: prefs.js:257
msgid "Automatically paste the entry into the active window when selected"
msgstr "Pegar automáticamente la entrada en la ventana activa al seleccionarla"

#: prefs.js:261
msgid "Open menu at cursor"
msgstr "Abrir el menú en el cursor"

#: prefs.js:262
msgid "When using the keyboard shortcut, open the menu at the cursor position"
msgstr "Al usar el atajo de teclado, abrir el menú en la posición del cursor"

#: prefs.js:267
msgid "Show the delete button on each item"
msgstr "Mostrar el botón de eliminar en cada ítem"

#: prefs.js:271
msgid "Tag"
msgstr "Etiquetar"

#: prefs.js:272
msgid "Show the tag button on each item"
msgstr "Mostrar el botón de etiquetar en cada ítem"

#: prefs.js:277
msgid "Show the paste button on each item"
msgstr "Mostrar el botón de pegar en cada ítem"

#: prefs.js:281
msgid "Pin"
msgstr "Anclar"

#: prefs.js:282
msgid "Show the pin/favorite button on each item"
msgstr "Mostrar el botón de anclar/favorito en cada ítem"

#: prefs.js:287
msgid "Show the edit button on each text item"
msgstr "Mostrar el botón de editar en cada ítem de texto"

#: prefs.js:291
msgid "Preview"
msgstr "Previsualizar"

#: prefs.js:292
msgid "Show the preview button on each image item"
msgstr "Mostrar el botón de previsualizar en cada ítem de imagen"

#: prefs.js:296
msgid "Cache images"
msgstr "Guardar imágenes en caché"

#: prefs.js:297
msgid "Save copied images to clipboard history"
msgstr "Guardar las imágenes copiadas en el historial del portapapeles"

#: prefs.js:302
msgid "Excluded Apps"
msgstr "Aplicaciones excluidas"

#: prefs.js:303
msgid "Content copied will not be saved while these apps are in focus"
msgstr ""
"El contenido copiado no se guardará mientras estas aplicaciones tengan el "
"foco"

#: prefs.js:314
msgid "Case-sensitive"
msgstr "Distinguir mayúsculas y minúsculas"

#: prefs.js:315
msgid "Match uppercase and lowercase letters exactly when searching"
msgstr "Tener en cuenta las mayúsculas y minúsculas al buscar"

#: prefs.js:319
msgid "Regular expressions"
msgstr "Expresiones regulares"

#: prefs.js:320
msgid "Allow regular expressions to filter clipboard entries"
msgstr ""
"Permitir expresiones regulares para filtrar las entradas del portapapeles"

#: prefs.js:333
msgid "Clear clipboard history on interval"
msgstr "Vaciar el historial del portapapeles periódicamente"

#: prefs.js:334
msgid "Automatically clear clipboard history at a recurring interval"
msgstr ""
"Vaciar automáticamente el historial del portapapeles cada cierto tiempo"

#: prefs.js:338
msgid "History clear interval (in minutes)"
msgstr "Intervalo de vaciado del historial (en minutos)"

#: prefs.js:358
msgid "Item Actions"
msgstr "Acciones de los ítems"

#: prefs.js:359
msgid "Import / Export History"
msgstr "Importar / Exportar historial"

#: prefs.js:362
msgid "Export history"
msgstr "Exportar historial"

#: prefs.js:368 prefs.js:494
msgid "Export clipboard history"
msgstr "Exportar el historial del portapapeles"

#: prefs.js:369
msgid "Save the registry and cached files as an archive"
msgstr "Guardar el registro y los archivos en caché en un archivo comprimido"

#: prefs.js:375
msgid "Import history"
msgstr "Importar historial"

#: prefs.js:381 prefs.js:494
msgid "Import clipboard history"
msgstr "Importar el historial del portapapeles"

#: prefs.js:382
msgid "Restore an archive created by this extension"
msgstr "Restaurar un archivo comprimido creado por esta extensión"

#: prefs.js:482
msgid "Clipboard history import/export failed"
msgstr "Error al importar o exportar el historial del portapapeles"

#: prefs.js:484
msgid "OK"
msgstr "Aceptar"

#: prefs.js:491
msgid "Clipboard history archives"
msgstr "Archivos comprimidos del historial del portapapeles"

#: prefs.js:495
msgid "Export"
msgstr "Exportar"

#: prefs.js:495
msgid "Import"
msgstr "Importar"

#: prefs.js:540
msgid "Clipboard history is empty"
msgstr "El historial del portapapeles está vacío"

#: prefs.js:549
msgid "Clipboard history exported"
msgstr "Historial del portapapeles exportado"

#: prefs.js:576
msgid "The selected file is not a clipboard history archive"
msgstr ""
"El archivo seleccionado no es un archivo comprimido del historial del "
"portapapeles"

#: prefs.js:592
msgid "Clipboard history imported"
msgstr "Historial del portapapeles importado"

#: prefs.js:597
msgid "Icon"
msgstr "Icono"

#: prefs.js:598
msgid "Clipboard Content"
msgstr "Contenido del portapapeles"

#: prefs.js:599
msgid "Both"
